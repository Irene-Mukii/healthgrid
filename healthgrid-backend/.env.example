# HealthGrid Backend — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Anthropic API — get from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Supabase — get from your project's Settings > API page
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server config
PORT=8000
